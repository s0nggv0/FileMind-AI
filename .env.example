# Defaults run Local-only Demo without credentials. Copy to .env.local.
# Dedicated FileMind database on your existing PostgreSQL service.
# Example: postgresql://filemind_user:URL_ENCODED_PASSWORD@localhost:5432/filemind_ai
DATABASE_URL=
# Private filesystem storage; use a persistent disk/volume on deployed servers.
FILE_STORAGE_ROOT=.filemind/storage
# Generate at least 32 random bytes. Required for persistent production sessions.
WORKSPACE_SESSION_SECRET=
# Only for local HTTP production previews. Keep true on a deployed HTTPS host.
WORKSPACE_COOKIE_SECURE=true

AI_ENGINE=mock
# Dedicated synthetic competition workspace; preserves the configured AI engine.
DEMO_MODE=false
# Forces real AI and disables development controls. Missing providers remain unavailable.
COMPETITION_MODE=false
AI_PROVIDER=kimi
AI_MODEL=kimi-k2.6
# Blank uses the main model; the current Kimi adapter supports kimi-k2.6 for both roles.
AI_SMALL_MODEL=
KIMI_API_KEY=
# Moonshot API endpoint, not the Kimi chat website or Kimi Code subscription endpoint.
KIMI_BASE_URL=https://api.moonshot.cn/v1
# Reserved for future adapters; not implemented or required in Phase 4.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Phase 5: independent Embedding provider. AI_ENGINE=mock uses fixture vectors.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
# Beijing endpoint. Other regions require their matching endpoint and API Key.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CONCURRENCY=2
# Experimental: current evaluation did not justify enabling by default.
RAG_RERANK_ENABLED=false

# Phase 6: real Vision requires the successful local verification marker.
# OCR languages and WASM are bundled; no external OCR installation or download.
VISION_CONCURRENCY=2
OCR_ENGINE=tesseract
# Use OCR_ENGINE=disabled only to explicitly disable extraction.

