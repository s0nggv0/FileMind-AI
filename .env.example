# Defaults run Local-only Demo without credentials. Copy to .env.local.
# Storage direction: ordinary PostgreSQL, replacing the legacy Supabase backend.
# PostgreSQL migration is pending; no DATABASE_URL adapter is implemented yet.
# Generate at least 32 random bytes. Required for persistent production sessions.
WORKSPACE_SESSION_SECRET=
# Only for local HTTP production previews. Keep true on a deployed HTTPS host.
WORKSPACE_COOKIE_SECURE=true

AI_ENGINE=mock
AI_PROVIDER=kimi
AI_MODEL=kimi-k2.6
# Blank uses the main model; configurable independently for document analysis.
AI_SMALL_MODEL=
KIMI_API_KEY=
# Moonshot API endpoint, not the Kimi chat website or Kimi Code subscription endpoint.
KIMI_BASE_URL=https://api.moonshot.cn/v1
# Reserved for future adapters; not implemented or required in Phase 4.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

