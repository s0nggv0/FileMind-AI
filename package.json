{
  "name": "filemind-ai",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/build/prepare-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build/prepare-build.mjs",
    "build": "next build",
    "postbuild": "node scripts/build/prepare-portable.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "db:migrate": "node scripts/database/migrate-database.mjs",
    "portable:start": "node scripts/portable-start.mjs",
    "portable:prepare": "node scripts/build/prepare-portable.mjs",
    "test:portable": "playwright test --config playwright.portable.config.ts",
    "test:portable:copy": "node scripts/verification/verify-portable.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:vision": "tsx scripts/verification/verify-vision-live.ts",
    "test:multimodal-live": "playwright test --config playwright.multimodal-live.config.ts",
    "evaluate:hard": "tsx scripts/evaluation/evaluate-rag-hard.ts --live",
    "evaluate:holdout": "tsx scripts/evaluation/evaluate-rag-holdout.ts --live",
    "evaluate:regression": "tsx scripts/evaluation/evaluate-regression.ts",
    "evaluate:calibration": "tsx scripts/evaluation/evaluate-regression.ts --inject-failures",
    "evaluate:review": "tsx scripts/evaluation/review-regression.ts",
    "test:evaluation": "tsx --test --test-concurrency=1 tests/evaluation-regression.test.ts tests/evaluation-runner.test.ts",
    "test:backup-portable": "node scripts/verification/verify-backup-portable.mjs",
    "test:crash-recovery": "tsx scripts/verification/verify-crash-recovery.ts",
    "demo:check": "tsx scripts/verification/demo-check.ts",
    "test:demo-preflight": "node scripts/verification/verify-demo-preflight.mjs",
    "test:phase9": "tsx --test tests/answer-context.test.ts tests/answer-verifier.test.ts",
    "test:phase9:kimi": "tsx scripts/verification/verify-phase9-kimi.ts --live"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@next/env": "16.3.8",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "ai": "7.0.127",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fflate": "0.8.3",
    "framer-motion": "13.5.0",
    "geist": "1.7.2",
    "lucide-react": "1.49.0",
    "mammoth": "1.13.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
